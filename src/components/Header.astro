---
import ToggleDarkMode from "../components/UI/ToggleDarkMode.astro";
import Options from "../components/UI/Options.astro";
import { Icon } from "astro-icon/components";

---

<div class="relative flex w-full px-5 py-5 text-[10px]">
	
	<!-- ANCHOR TO LEFT -->
	<div class="mr-auto flex">
		<div class="md:justify-self-start flex gap-5 items-center">
			<button onclick="history.back();" class="hidden md:flex hover:cursor-pointer text-[25px] items-center translate-y-0.5">
				<Icon name="back"/>
			</button>
			<ToggleDarkMode />
		</div>
	</div>
	
	<!-- ANCHOR TO RIGHT -->
	<div class="ml-auto flex">
		<div class="md:justify-self-end flex gap-5 items-center">
			<Options />
		</div>
	</div>
</div>
