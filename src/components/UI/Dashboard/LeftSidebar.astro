---
import { Icon } from "astro-icon/components";
import VerifyWorlds from "./Svelte/Widgets/VerifyWorlds.svelte";

const data = {
    authToken: Astro.cookies.get("authorization.token")?.value,
    userUUID: Astro.cookies.get("profile.uuid")?.value,
};

let userData;
if (data.userUUID) {
  const userDataResponse = await fetch(
      `https://wwlc.legiti.dev/api/user/${data.userUUID!.split("-").join("")}`,
      { headers: { Authorization: `Bearer ${data.authToken}` } },
  );
  userData = await userDataResponse.json()
}

---

<!-- LEFT SIDEBAR -->
<div class="left-sidebar hidden md:flex flex-col gap-5 h-full">
    <!-- World -->
    <div class="mt-5">
        <!-- <div class="py-1">
                    <h1>Worlds</h1>
               </div>
                -->
        <ul class="flex flex-col gap-2">
            <a
                href="/dashboard/my-worlds"
                class="flex items-center gap-x-2 p-1 dark:hover:bg-main-light/10 hover:bg-main-dark/10 duration-300 hover:cursor-pointer rounded-ui"
            >
                <span class="text-2xl"><Icon name="world" /></span>
                Your Worlds
            </a>
            <a
                href="/dashboard/my-jobs"
                class="flex items-center gap-x-2 p-1 dark:hover:bg-main-light/10 hover:bg-main-dark/10 duration-300 hover:cursor-pointer rounded-ui"
            >
                <span class="text-2xl"><Icon name="apps" /></span>
                Your Jobs
            </a>
            <a
                href="/dashboard/create-job"
                class="flex items-center gap-x-2 p-1 dark:hover:bg-main-light/10 hover:bg-main-dark/10 duration-300 hover:cursor-pointer rounded-ui"
            >
                <span class="text-2xl"><Icon name="plus" /></span>
                Create New Job
            </a>
        </ul>
    </div>
    <div
        class="h-0 justify-self-center flex dark:border-b-white/40 border-b-black/40 border-b my-2 mx-auto w-[90%]"
    >
    </div>
    <!-- Profile -->
    <div class="">
        <ul class="flex flex-col gap-2">
            <a
                href="/dashboard/transactions"
                class="flex items-center gap-x-2 p-1 dark:hover:bg-main-light/10 hover:bg-main-dark/10 duration-300 hover:cursor-pointer rounded-ui"
            >
                {userData ? (
                    <div class="flex items-center gap-2">
                        <span class="text-2xl"><Icon name="wallet" /></span>
                        Balance: {userData.balance}
                    </div>
                ) : (
                    <div class="flex items-center gap-2">
                        <span class="text-2xl"><Icon name="wallet" /></span>
                        Balance: <span class="text-red-600 text-[12px]">Not Logged In</span>
                    </div>
                )}
                
            </a>
        </ul>
    </div>

    <div
        class="h-0 justify-self-center flex dark:border-b-white/40 border-b-black/40 border-b my-2 mx-auto w-[90%]"
    >
    </div>
    <!-- Terms of Use -->
    <div class="">
        <ul class="flex flex-col gap-2">
            <a
                href="/docs/terms-of-use"
                class="flex items-center gap-x-2 p-1 dark:hover:bg-main-light/10 hover:bg-main-dark/10 duration-300 hover:cursor-pointer rounded-ui"
            >
                <span class="text-2xl"><Icon name="info" /></span>
                Terms of Use
            </a>
        </ul>
    </div>

    <VerifyWorlds client:idle cookies={data} />
</div>
