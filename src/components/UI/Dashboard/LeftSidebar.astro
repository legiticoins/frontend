---
import { Icon } from "astro-icon/components";
---

          <!-- LEFT SIDEBAR -->
     <div class="left-sidebar hidden md:flex flex-col gap-5">
          <!-- World -->
          <div class="mt-5">
               <!-- <div class="py-1">
                    <h1>Worlds</h1>
               </div>
                -->
               <ul class="flex flex-col gap-2">
                    <a href="/dashboard/my-worlds" class="flex items-center gap-x-2 p-1 dark:hover:bg-main-light/10 hover:bg-main-dark/10 duration-300 hover:cursor-pointer rounded-ui">
                         <span class="text-2xl"><Icon name="world" /></span>
                         Your Worlds
                    </a>
                    <a href="/dashboard/my-jobs" class="flex items-center gap-x-2 p-1 dark:hover:bg-main-light/10 hover:bg-main-dark/10 duration-300 hover:cursor-pointer rounded-ui">
                         <span class="text-2xl"><Icon name="apps" /></span>
                         Your Job
                    </a>
                    <a href="/dashboard/create-job" class="flex items-center gap-x-2 p-1 dark:hover:bg-main-light/10 hover:bg-main-dark/10 duration-300 hover:cursor-pointer rounded-ui">
                         <span class="text-2xl"><Icon name="plus" /></span>
                         Create New Job
                    </a>
               </ul>
          </div>
          <div class="h-0 justify-self-center flex dark:border-b-white/40 border-b-black/40 border-b my-2 mx-auto w-[90%]"></div>     
          <!-- Profile -->
          <div class="">
               <ul class="flex flex-col gap-2">
                    <a href="/dashboard/wallet" class="flex items-center gap-x-2 p-1 dark:hover:bg-main-light/10 hover:bg-main-dark/10 duration-300 hover:cursor-pointer rounded-ui">
                         <span class="text-2xl"><Icon name="wallet" /></span>
                         My Wallet
                    </a>
                    <a href="/dashboard/transactions" class="flex items-center gap-x-2 p-1 dark:hover:bg-main-light/10 hover:bg-main-dark/10 duration-300 hover:cursor-pointer rounded-ui">
                         <span class="text-2xl"><Icon name="transactions" /></span>
                         Transactions
                    </a>
                    <a href="/dashboard/market" class="flex items-center gap-x-2 p-1 dark:hover:bg-main-light/10 hover:bg-main-dark/10 duration-300 hover:cursor-pointer rounded-ui">
                         <span class="text-2xl"><Icon name="market" /></span>
                         Market
                    </a>
                    <a href="/dashboard/settings" class="flex items-center gap-x-2 p-1 dark:hover:bg-main-light/10 hover:bg-main-dark/10 duration-300 hover:cursor-pointer rounded-ui">
                         <span class="text-[20px] scale-80 translate-x-0.5"><Icon name="settings" /></span>
                         Settings
                    </a>
               </ul>
          </div>
          
          <div class="h-0 justify-self-center flex dark:border-b-white/40 border-b-black/40 border-b my-2 mx-auto w-[90%]"></div>     
          <!-- Terms of Use -->
          <div class="">
               <ul class="flex flex-col gap-2">
                    <a href="/terms-of-use" class="flex items-center gap-x-2 p-1 dark:hover:bg-main-light/10 hover:bg-main-dark/10 duration-300 hover:cursor-pointer rounded-ui">
                         <span class="text-2xl"><Icon name="info" /></span>
                         Terms of Use
                    </a>
               </ul>
          </div>
     </div>
