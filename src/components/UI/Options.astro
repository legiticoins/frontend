---
import { Icon } from "astro-icon/components";
---

<div class="dropdown dropdown-end gap-2 font-ui hover:cursor-pointer">
  <div tabindex="0" role="button" class="text-2xl">
     <Icon name="options"/>
  </div>
  <ul tabindex="-1" class="w-60 my-1 dropdown-content justify-items-start menu z-1 header-options">
     
     
     <!-- Job -->

     <!-- Create New Job -->
     <li>
          <a href="/my-jobs" class="flex text-[13px] items-center hover:bg-black/10 hover:dark:bg-white/10"> 
               <div class="text-2xl">
                    <Icon name="apps"/>
               </div>
               My Jobs
          </a>
          <a href="/create-job" class="flex text-[13px] items-center hover:bg-black/10 hover:dark:bg-white/10"> 
               <div class="text-2xl">
                    <Icon name="plus"/>
               </div>
               Create New Job
          </a>
     </li>

     <!-- LINE -->
     <div class="h-0 justify-self-center flex hover:border-b-white/90 border-b my-2 m-auto w-[90%]"></div>     
     
     <!-- Profile -->
     <li>
          <a href="/profile" class="flex text-[13px] items-center hover:bg-black/10 hover:dark:bg-white/10">
               <div class="text-2xl scale-70">
                    <Icon name="profile"/>
               </div>
               Profile
          </a>
     </li>

     <!-- Transactions -->
     <li>
          <a href="/transactions" class="flex text-[13px] items-center hover:bg-black/10 hover:dark:bg-white/10"> 
               <div class="text-2xl">
                    <Icon name="transactions"/>
               </div>
               Transactions
          </a>
     </li>
     
     <!-- Logout -->
     <li>
          <a href="/logout" class="flex text-[13px] items-center hover:bg-red-400/50 text-red-400"> 
               <div class="text-2xl scale-70">
                    <Icon name="logout"/>
               </div>
               Logout
          </a>
     </li>

     <!-- LINE -->
     <div class="h-0 justify-self-center flex hover:border-b-white/90 border-b my-2 m-auto w-[90%]"></div>     
          
     <!-- Terms of Use -->
     <li>
          <a href="/profile" class="flex text-[13px] items-center hover:bg-black/10 hover:dark:bg-white/10">
               <div class="text-2xl scale-70">
                    <Icon name="info"/>
               </div>
               Terms of Use
          </a>
     </li>

  </ul>
</div>
