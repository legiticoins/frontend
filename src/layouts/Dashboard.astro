---
import { ClientRouter } from 'astro:transitions';

import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeftSidebar from "../components/UI/Dashboard/LeftSidebar.astro";
import RightSidebar from "../components/UI/Dashboard/RightSidebar.astro";

const { title = "WWLC"} = Astro.props;
---


<html lang="en" id="html">
	<head>
		<meta charset="utf-8" />

		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="WWLC" />
		<link rel="manifest" href="/site.webmanifest" />

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<ClientRouter />
		<script is:inline>
     	 (function () {
     	   const saved = localStorage.getItem("theme");
     	   const theme = saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
     	   document.documentElement.setAttribute("data-theme", theme);
     	 })();
    		</script>

	</head>
	<body class="dashboard flex flex-col w-full min-h-screen">
		<Header />
          <div class="flex-1 w-full flex px-5 pb-5 overflow-y-auto mb-30 md:mb-0">
          	<LeftSidebar />
			<slot />
          </div>
          <Footer />
	</body>
</html>
