---
export const prerender = false;
import Layout from '../../../layouts/Dashboard.astro'
import Page from '../../../components/UI/Dashboard/Svelte/VerifyWorlds.svelte'

const data = {
     authToken: Astro.cookies.get("authorization.token")?.value,
     userUUID: Astro.cookies.get("profile.uuid")?.value,
}

---
<Layout title="Verify World">
     <Page client:load cookies={data}/>
</Layout>