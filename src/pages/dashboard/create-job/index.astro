---
export const prerender = false;
import Layout from "../../../layouts/Dashboard.astro"

const worldTokenParam = Astro.url.searchParams.get('worldToken')

const title = "Create a Job"

let name, type, amount, world_token, id;

// Make Post Request
function createJob() {
     const body = {
          name,
          type: "sell",
          amount,
          world_token
     }
}



---
<Layout title={title}>
     <div class="w-full md:px-5 font-ui">

          <h1 class="text-mobile-title mb-5">{title}</h1>
          
          <div class="max-h-150 h-full md:w-100 flex flex-col gap-2">
               <form class="flex flex-col gap-5">
                    <!-- Job Name -->
                    <label class="flex flex-col">
                         Enter Job Name
                         <input class="bg-black/20 dark:bg-white/20 rounded-ui p-2 text-black dark:text-white" type="text">
                    </label>

                    <!-- Job Pay -->
                    <label class="flex flex-col">
                         Enter Pay
                         <input class="bg-black/20 dark:bg-white/20 rounded-ui p-2 text-black dark:text-white" type=number>
                    </label>

                    <!-- Job Name -->
                    <label class="flex flex-col">
                         Enter World Token
                         <p class="text-[13px] opacity-50 italic">Don't know your world token? Click '+' from Your Worlds tab.</p>
                         <input value={worldTokenParam} class="bg-black/20 dark:bg-white/20 rounded-ui p-2 text-black dark:text-white" type="text">
                    </label>
               
                    <div class="my-2">
                         <button class="bg-black/20 dark:bg-white/20 rounded-ui p-2 text-black dark:text-white" type="submit">Create Job</button>
                    </div>
               </form>
          </div>
     </div>
</Layout>

<style is:global>
     @import '../../../styles/global.css'
</style>