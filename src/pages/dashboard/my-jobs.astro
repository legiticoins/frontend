---
import Layout from "../../layouts/Dashboard.astro"
import JobsSvelteComponent from "../../components/UI/Dashboard/Svelte/Jobs.svelte"

const title = "My Jobs"


const data = {
     authToken : Astro.cookies.get("authorization.token")?.value,
     userUUID : Astro.cookies.get("profile.uuid")?.value,
}

---
<Layout title={title}>
     <JobsSvelteComponent client:idle cookies={data} />
</Layout>