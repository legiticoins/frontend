---
import Layout from '../layouts/Layout.astro'
import { Icon } from "astro-icon/components"
---

<Layout title="WWLC">
	<div class="w-full p-5 absolute md:top-1/2 left-1/2 -translate-x-1/2 md:-translate-y-1/2 flex flex-col justify-center gap-5 md:gap-10">
		<div class="text-left md:text-center select-none">
			<h1 class="md:text-4xl text-4xl font-wordmark w-10 md:w-full">World Wide Legiticoins</h1>
			<h2 class="md:text-2xl text font-motto opacity-50">Coming Soon — from legitidevs.</h2>
		</div>

		<!-- Links -->
		<div class="flex flex-col md:flex-row justify-center gap-1 md:gap-10">
			<a class="font-ui flex gap-1 items-center hover:underline" href="https://legiti.dev/">	Home 	<Icon name="navigate"/>	</a>
			<a class="font-ui flex gap-1 items-center hover:underline" href="https://legiti.dev/team">	About Us 	<Icon name="navigate"/>	</a>
			<a class="font-ui flex gap-1 items-center hover:underline" href="https://discord.com/invite/gnk7ZtBSjZ">	Discord 	<Icon name="navigate"/>	</a>
		</div>
	</div>
</Layout>
