---
import Layout from '../layouts/Layout.astro'
import { Icon } from "astro-icon/components"
---

<Layout title="World Wide Legiticoins">

	<div class="w-full p-5 md:absolute relative md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2 flex flex-col justify-center gap-5 md:gap-10">
		<div class="text-left md:text-center select-none">
			<h1 class="md:text-4xl text-4xl font-wordmark w-10 md:w-full">World Wide Legiticoins</h1>
			<h2 class="md:text-[15px] text-[10px] font-motto opacity-50">Coming Soon — from legitidevs.</h2>
		</div>

		<!-- Links -->
		<div class="flex h-full bottom-0 flex-col md:flex-row justify-center gap-1 md:gap-10">
			<a class="font-ui flex gap-1 items-center hover:underline" href="https://legiti.dev/" target="_blank" rel="noopener noreferrer">	Home 	<Icon name="navigate"/>	</a>
			<a class="font-ui flex gap-1 items-center hover:underline" href="https://legiti.dev/team" target="_blank" rel="noopener noreferrer">	About Us 	<Icon name="navigate"/>	</a>
			<a class="font-ui flex gap-1 items-center hover:underline" href="https://discord.com/invite/gnk7ZtBSjZ" target="_blank" rel="noopener noreferrer">	Discord 	<Icon name="navigate"/>	</a>
		</div>
	</div>
</Layout>
