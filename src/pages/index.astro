---
import Layout from '../layouts/Layout.astro'
import { Icon } from "astro-icon/components"
---

<Layout title="WWLC">
	<div 
		class="w-full absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col justify-center gap-10">
		<div class="text-center">
			<h1 class="md:text-4xl font-wordmark">World Wide Legiticoins</h1>
			<h2 class="md:text-2xl font-motto opacity-50">Coming Soon — from legitidevs.</h2>
		</div>

		<!-- Links -->
		<div class="flex justify-center gap-10">
			<a class="font-ui flex gap-1 items-center">	Home 	<Icon name="navigate"/>	</a>
			<a class="font-ui flex gap-1 items-center">	About Us 	<Icon name="navigate"/>	</a>
			<a class="font-ui flex gap-1 items-center">	Discord 	<Icon name="navigate"/>	</a>
		</div>
	</div>
</Layout>
